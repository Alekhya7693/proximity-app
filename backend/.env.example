# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ─── Database (PostgreSQL + PostGIS) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=myko
DB_PASSWORD=myko_secret
DB_DATABASE=myko_db
DB_SSL=false
DB_SYNCHRONIZE=true
DB_LOGGING=true

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT / Auth ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=myko

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_CREDENTIALS=true

# ─── Firebase (Push Notifications) ────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Location ─────────────────────────────────────────────
MAX_DISCOVERY_RADIUS_KM=50
DEFAULT_DISCOVERY_RADIUS_KM=10
LOCATION_UPDATE_THROTTLE_MS=30000
LOCATION_SPOOF_DETECTION=true

# ─── Discovery / Feed ────────────────────────────────────
DISCOVERY_PAGE_SIZE=20
DISCOVERY_BOOST_NEW_USERS_HOURS=72

# ─── Rate Limiting ───────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ─── File Storage ────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_DEST=./uploads

# ─── Feature Flags ───────────────────────────────────────
FF_VIBE_CHECK=true
FF_VIDEO_CHAT=false
FF_PROFESSIONAL_MODE=true
FF_GROUP_VIBES=false

# ─── BullMQ ──────────────────────────────────────────────
BULL_QUEUE_PREFIX=myko
CLEANUP_CRON=0 3 * * *
